<Window x:Class="IMEIndicatorClock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="SettingsWindowRoot"
        Width="450"
        Height="600"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Topmost="True"
        Title="設定">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" Text="設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- タブコントロール -->
        <TabControl Grid.Row="1">
            <!-- ==================== マウスカーソルインジケーター設定 ==================== -->
            <TabItem Header="インジケーター">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 表示スイッチ -->
                        <CheckBox x:Name="MouseIndicatorVisibleCheck" Content="インジケーターを表示" Margin="0,0,0,15"
                                  Checked="MouseIndicatorVisible_Changed" Unchecked="MouseIndicatorVisible_Changed"/>
                        <Separator Margin="0,0,0,15"/>

                        <!-- 説明 -->
                        <TextBlock Text="マウスカーソル付近に日本語IMEのON/OFF状態を表示します。" TextWrapping="Wrap" Margin="0,0,0,15" Opacity="0.8"/>

                        <!-- サイズ -->
                        <TextBlock Text="サイズ" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="20" Maximum="100"
                                    Value="{Binding MouseCursorIndicatorViewModel.Size}"
                                    TickFrequency="2" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1" Text="{Binding MouseCursorIndicatorViewModel.Size, StringFormat={}{0:F0}px}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- オフセット XY -->
                        <TextBlock Text="カーソルからのオフセット" FontWeight="SemiBold" Margin="0,10,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="X"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-40" Maximum="40"
                                            Value="{Binding MouseCursorIndicatorViewModel.OffsetX}"
                                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MouseCursorIndicatorViewModel.OffsetX, StringFormat={}{0:F0}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Y"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-40" Maximum="40"
                                            Value="{Binding MouseCursorIndicatorViewModel.OffsetY}"
                                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MouseCursorIndicatorViewModel.OffsetY, StringFormat={}{0:F0}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- 不透明度 -->
                        <TextBlock Text="不透明度" FontWeight="SemiBold" Margin="0,10,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0.1" Maximum="1.0"
                                    Value="{Binding MouseCursorIndicatorViewModel.Opacity}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1" Text="{Binding MouseCursorIndicatorViewModel.Opacity, StringFormat={}{0:P0}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,15,0,15"/>

                        <!-- IME ON 設定 -->
                        <TextBlock Text="IME ON（日本語入力時）" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="背景色"/>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ImeOnColorPreview" Width="20" Height="20" CornerRadius="3"
                                            BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,5,0"/>
                                    <TextBox x:Name="ImeOnColorText" Grid.Column="1" MaxLength="7"
                                             TextChanged="ImeOnColor_TextChanged"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="表示文字"/>
                                <TextBox x:Name="ImeOnTextInput" Margin="0,3,0,0" MaxLength="4"
                                         TextChanged="ImeOnText_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- IME OFF 設定 -->
                        <TextBlock Text="IME OFF（英数入力時）" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="背景色"/>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ImeOffColorPreview" Width="20" Height="20" CornerRadius="3"
                                            BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,5,0"/>
                                    <TextBox x:Name="ImeOffColorText" Grid.Column="1" MaxLength="7"
                                             TextChanged="ImeOffColor_TextChanged"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="表示文字"/>
                                <TextBox x:Name="ImeOffTextInput" Margin="0,3,0,0" MaxLength="4"
                                         TextChanged="ImeOffText_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== バージョン情報 ==================== -->
            <TabItem Header="バージョン情報">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15" HorizontalAlignment="Center">
                        <!-- アプリ名とバージョン -->
                        <TextBlock Text="IME Indicator" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="for Windows" FontSize="14" Opacity="0.7"
                                   HorizontalAlignment="Center" Margin="0,5,0,5"/>
                        <TextBlock x:Name="LblVersion" HorizontalAlignment="Center"/>
                        <TextBlock Text="日本語IMEの状態をマウスカーソル付近に表示するツール"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" MaxWidth="400"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Run Text="© 2025-2026 obott9"/>
                        </TextBlock>
                        <TextBlock Text="MIT License" HorizontalAlignment="Center" Opacity="0.7"/>

                        <Separator Margin="0,20,0,15"/>

                        <!-- デバッグログスイッチ -->
                        <CheckBox x:Name="DebugModeCheck" Content="デバッグログを有効にする" HorizontalAlignment="Center"
                                  Checked="DebugMode_Changed" Unchecked="DebugMode_Changed"/>

                        <Separator Margin="0,15,0,15"/>

                        <Button Content="設定をリセット" Width="150" Click="ResetSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="閉じる" Width="80" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
