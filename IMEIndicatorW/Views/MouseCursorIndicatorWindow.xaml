<Window x:Class="IMEIndicatorClock.Views.MouseCursorIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse Cursor Indicator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        IsHitTestVisible="False">

    <Grid Width="{Binding Size}" Height="{Binding Size}"
          Opacity="{Binding Opacity}">
        <!-- 外側のグロー効果 -->
        <Ellipse>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{Binding BackgroundColor.Color}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- メインの円（LinearGradient） -->
        <Ellipse Margin="3">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{Binding BackgroundColor.Color}" Offset="0"/>
                    <GradientStop Color="{Binding GlowColor.Color}" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 白いボーダー -->
        <Ellipse Margin="3" Stroke="White" StrokeThickness="1" Opacity="0.3"/>

        <!-- テキスト -->
        <TextBlock Text="{Binding DisplayText}"
                   FontSize="{Binding FontSize}"
                   FontFamily="{Binding FontFamily}"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="1" ShadowDepth="0.5" Opacity="0.3"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
