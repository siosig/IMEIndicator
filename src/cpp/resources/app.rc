// IMEIndicator リソースファイル
// アイコン・マニフェスト・バージョン情報を埋め込む

#include <winres.h>
#include "version.h"
#include "resource_ids.h"

// ---- アイコン ----
// Release: app.ico、Debug: app-debug.ico を埋め込む
// 最初に出現するアイコンが GroupIcon の代表になるため、ID 順に注意
#ifdef _DEBUG
IDI_APPLICATION ICON "app-debug.ico"
#else
IDI_APPLICATION ICON "app.ico"
#endif

// ---- 背景画像（013-ime-corner-image） ----
// 画面右上 IME ON 背景画像。512x512 RGBA PNG（四隅透過）を RT_RCDATA として埋め込み、
// WicImageLoader::lockRcData で読み出して WIC でデコードする。
IDR_BACKGROUND_IMAGE_PNG RCDATA "ime-on-background.png"

// ---- マニフェスト ----
// CREATEPROCESS_MANIFEST_RESOURCE_ID = 1
1 RT_MANIFEST "app.manifest"

// ---- バージョン情報 ----
VS_VERSION_INFO VERSIONINFO
    FILEVERSION    IMEINDICATOR_VERSION_NUM
    PRODUCTVERSION IMEINDICATOR_VERSION_NUM
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0x0411 = ja-JP, 0x04B0 = Unicode
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName",      "obott9"
            VALUE "FileDescription",  "IME Indicator (C++ native port)"
            VALUE "FileVersion",      IMEINDICATOR_VERSION_STR
            VALUE "InternalName",     "IMEIndicator"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "IMEIndicator.exe"
            VALUE "ProductName",      "IME Indicator"
            VALUE "ProductVersion",   IMEINDICATOR_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // ja-JP, Unicode
        VALUE "Translation", 0x0411, 0x04B0
    END
END
