<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>IMEIndicator</AssemblyName>
    <RootNamespace>IMEIndicator</RootNamespace>
    <Version>1.2.9</Version>
    <Authors>obott9</Authors>
    <Description>IME Indicator for Windows - Display IME status</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

  <!-- Debug用アイコン -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationIcon>app-debug.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release用アイコン -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 発行設定（共通） -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 日本語専用: jaサテライトアセンブリのみ出力 -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Self-contained発行設定（.NET同梱一体型） -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- トリミングは .NET 10 で WPF 非サポートのため無効 -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app-debug.ico" />
    <Content Include="Resources\app.ico" Condition="'$(Configuration)' == 'Release'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\app-debug.ico" Condition="'$(Configuration)' == 'Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IMEIndicatorW.Tests" />
  </ItemGroup>

</Project>
