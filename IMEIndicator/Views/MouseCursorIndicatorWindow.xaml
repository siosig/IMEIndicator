<Window x:Class="IMEIndicator.Views.MouseCursorIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse Cursor Indicator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="{Binding Size}"
        Height="{Binding Size}"
        IsHitTestVisible="False"
        ShowActivated="False"
        Focusable="False">

    <Grid Opacity="{Binding Opacity}"
          RenderOptions.BitmapScalingMode="LowQuality">
        <Grid.CacheMode>
            <BitmapCache RenderAtScale="1" EnableClearType="False" SnapsToDevicePixels="False"/>
        </Grid.CacheMode>
        <!-- 外側のグロー効果 -->
        <Ellipse>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{Binding BackgroundColor.Color}"
                            Offset="0"/>
                    <GradientStop Color="Transparent"
                            Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- メインの円（LinearGradient） -->
        <Ellipse Margin="3">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0"
                        EndPoint="1,1">
                    <GradientStop Color="{Binding BackgroundColor.Color}"
                            Offset="0"/>
                    <GradientStop Color="{Binding GlowColor.Color}"
                            Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 白いボーダー -->
        <Ellipse Margin="3"
                Stroke="White"
                StrokeThickness="1"
                Opacity="0.3"/>

        <!-- テキスト影（DropShadowEffect廃止 → 軽量な重ね描画で代替） -->
        <TextBlock Text="{Binding DisplayText}"
                   FontSize="{Binding FontSize}"
                   FontFamily="{Binding FontFamily}"
                   FontWeight="Bold"
                   Foreground="Black"
                   Opacity="0.25"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0.5,0.5,0,0"/>
        <!-- テキスト本体 -->
        <TextBlock Text="{Binding DisplayText}"
                   FontSize="{Binding FontSize}"
                   FontFamily="{Binding FontFamily}"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>
