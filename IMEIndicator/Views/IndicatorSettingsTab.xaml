<UserControl x:Class="IMEIndicator.Views.IndicatorSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <!-- 表示スイッチ -->
            <CheckBox x:Name="MouseIndicatorVisibleCheck"
                    Content="インジケーターを表示"
                    Margin="0,0,0,15"
                    Checked="MouseIndicatorVisible_Changed"
                    Unchecked="MouseIndicatorVisible_Changed"/>
            <Separator Margin="0,0,0,15"/>

            <!-- サイズ -->
            <TextBlock Text="サイズ"
                    FontWeight="SemiBold"
                    Margin="0,0,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Minimum="20"
                        Maximum="100"
                        Value="{Binding MouseCursorIndicatorViewModel.Size}"
                        TickFrequency="2"
                        IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="1"
                        Text="{Binding MouseCursorIndicatorViewModel.Size, StringFormat={}{0:F0}px}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- オフセット XY -->
            <TextBlock Text="カーソルからのオフセット"
                    FontWeight="SemiBold"
                    Margin="0,10,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">
                    <TextBlock Text="X"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="-40"
                                Maximum="40"
                                Value="{Binding MouseCursorIndicatorViewModel.OffsetX}"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1"
                                Text="{Binding MouseCursorIndicatorViewModel.OffsetX, StringFormat={}{0:F0}}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Y"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="-40"
                                Maximum="40"
                                Value="{Binding MouseCursorIndicatorViewModel.OffsetY}"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1"
                                Text="{Binding MouseCursorIndicatorViewModel.OffsetY, StringFormat={}{0:F0}}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 不透明度 -->
            <TextBlock Text="不透明度"
                    FontWeight="SemiBold"
                    Margin="0,10,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Minimum="0.1"
                        Maximum="1.0"
                        Value="{Binding MouseCursorIndicatorViewModel.Opacity}"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="1"
                        Text="{Binding MouseCursorIndicatorViewModel.Opacity, StringFormat={}{0:P0}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
