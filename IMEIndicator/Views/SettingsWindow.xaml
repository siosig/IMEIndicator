<Window x:Class="IMEIndicator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:IMEIndicator.ViewModels"
        x:Name="SettingsWindowRoot"
        Width="450"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Topmost="True"
        Title="設定">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル（バージョン付き） -->
        <TextBlock x:Name="TitleText"
                Grid.Row="0"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,10"/>

        <!-- 電源モード選択 -->
        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="0,0,0,15">
            <TextBlock Text="電源モード："
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    FontWeight="SemiBold"/>
            <RadioButton x:Name="PowerModeEfficiency"
                    Content="最適な電力効率"
                    GroupName="PowerMode"
                    Margin="0,0,15,0"
                    Checked="PowerMode_Checked"/>
            <RadioButton x:Name="PowerModeBalanced"
                    Content="バランス"
                    GroupName="PowerMode"
                    Margin="0,0,15,0"
                    Checked="PowerMode_Checked"/>
            <RadioButton x:Name="PowerModePerformance"
                    Content="最適なパフォーマンス"
                    GroupName="PowerMode"
                    Checked="PowerMode_Checked"/>
        </StackPanel>

        <!-- タブコントロール -->
        <TabControl Grid.Row="2">
            <!-- ==================== マウスカーソルインジケーター設定 ==================== -->
            <TabItem Header="インジケーター">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 表示スイッチ -->
                        <CheckBox x:Name="MouseIndicatorVisibleCheck"
                                Content="インジケーターを表示"
                                Margin="0,0,0,15"
                                  Checked="MouseIndicatorVisible_Changed"
                                Unchecked="MouseIndicatorVisible_Changed"/>
                        <Separator Margin="0,0,0,15"/>

                        <!-- サイズ -->
                        <TextBlock Text="サイズ"
                                FontWeight="SemiBold"
                                Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="20"
                                    Maximum="100"
                                    Value="{Binding MouseCursorIndicatorViewModel.Size}"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1"
                                    Text="{Binding MouseCursorIndicatorViewModel.Size, StringFormat={}{0:F0}px}"
                                       HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- オフセット XY -->
                        <TextBlock Text="カーソルからのオフセット"
                                FontWeight="SemiBold"
                                Margin="0,10,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">
                                <TextBlock Text="X"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-40"
                                            Maximum="40"
                                            Value="{Binding MouseCursorIndicatorViewModel.OffsetX}"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1"
                                            Text="{Binding MouseCursorIndicatorViewModel.OffsetX, StringFormat={}{0:F0}}"
                                               HorizontalAlignment="Right"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Y"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="-40"
                                            Maximum="40"
                                            Value="{Binding MouseCursorIndicatorViewModel.OffsetY}"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1"
                                            Text="{Binding MouseCursorIndicatorViewModel.OffsetY, StringFormat={}{0:F0}}"
                                               HorizontalAlignment="Right"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- 不透明度 -->
                        <TextBlock Text="不透明度"
                                FontWeight="SemiBold"
                                Margin="0,10,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0.1"
                                    Maximum="1.0"
                                    Value="{Binding MouseCursorIndicatorViewModel.Opacity}"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1"
                                    Text="{Binding MouseCursorIndicatorViewModel.Opacity, StringFormat={}{0:P0}}"
                                       HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== プロセス優先度 ==================== -->
            <TabItem Header="プロセス優先度">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ポーリング間隔設定 -->
                    <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">
                        <TextBlock Text="監視間隔："
                                VerticalAlignment="Center"/>
                        <TextBox x:Name="PollingIntervalInput"
                                Width="60"
                                Margin="5,0,5,0"
                                TextChanged="PollingInterval_TextChanged"/>
                        <TextBlock Text="秒（1～1800）"
                                VerticalAlignment="Center"
                                Opacity="0.7"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                            x:Name="PriorityRulesGrid"
                            Height="200"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            SelectionMode="Single"
                            HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                            CellEditEnding="PriorityRulesGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="有効"
                                                    Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="40"/>
                            <DataGridTemplateColumn Header="プロセス名" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProcessName}" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox x:Name="ProcessNameInput"
                                                     Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="ProcessNameInput_TextChanged"
                                                     PreviewKeyDown="ProcessNameInput_PreviewKeyDown"
                                                     LostFocus="ProcessNameInput_LostFocus"/>
                                            <Popup x:Name="ProcessNamePopup"
                                                   PlacementTarget="{Binding ElementName=ProcessNameInput}"
                                                   Placement="Bottom"
                                                   StaysOpen="True"
                                                   IsOpen="False"
                                                   AllowsTransparency="True">
                                                <Border BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        Background="White"
                                                        MaxHeight="200">
                                                    <ListBox x:Name="ProcessNameSuggestions"
                                                             PreviewMouseLeftButtonUp="ProcessNameSuggestion_MouseClick">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Style.Triggers>
                                                                    <!-- フォーカスがなくても選択状態を視認可能にする -->
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                    </ListBox>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridComboBoxColumn Header="優先度"
                                                    SelectedItemBinding="{Binding TargetPriority, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="100"/>
                            <DataGridCheckBoxColumn Header="E-Core固定"
                                                    Binding="{Binding UseECoreOnly, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="IsEnabled" Value="{Binding Source={x:Static viewmodels:ProcessPrioritySettingsViewModel.HasECores}}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static viewmodels:ProcessPrioritySettingsViewModel.HasECores}}" Value="False">
                                                <Setter Property="ToolTip" Value="このCPUにはE-Coreがありません"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="IsEnabled" Value="{Binding Source={x:Static viewmodels:ProcessPrioritySettingsViewModel.HasECores}}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static viewmodels:ProcessPrioritySettingsViewModel.HasECores}}" Value="False">
                                                <Setter Property="ToolTip" Value="このCPUにはE-Coreがありません"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">
                        <Button Content="追加"
                                Width="60"
                                Margin="0,0,5,0"
                                Click="AddPriorityRule_Click"/>
                        <Button Content="削除"
                                Width="60"
                                Click="RemovePriorityRule_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ボタン -->
        <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
            <Button Content="閉じる"
                    Width="80"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
