<Window x:Class="IMEIndicator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IMEIndicator.Views"
        x:Name="SettingsWindowRoot"
        Width="450"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Topmost="True"
        Title="設定">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル（バージョン付き） -->
        <TextBlock x:Name="TitleText"
                Grid.Row="0"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,10"/>

        <!-- 電源モード選択 -->
        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="0,0,0,15">
            <TextBlock Text="電源モード："
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    FontWeight="SemiBold"/>
            <RadioButton x:Name="PowerModeEfficiency"
                    Content="最適な電力効率"
                    GroupName="PowerMode"
                    Margin="0,0,15,0"
                    Checked="PowerMode_Checked"/>
            <RadioButton x:Name="PowerModeBalanced"
                    Content="バランス"
                    GroupName="PowerMode"
                    Margin="0,0,15,0"
                    Checked="PowerMode_Checked"/>
            <RadioButton x:Name="PowerModePerformance"
                    Content="最適なパフォーマンス"
                    GroupName="PowerMode"
                    Checked="PowerMode_Checked"/>
        </StackPanel>

        <!-- タブコントロール -->
        <TabControl Grid.Row="2">
            <TabItem Header="インジケーター">
                <views:IndicatorSettingsTab x:Name="IndicatorTab"/>
            </TabItem>
            <TabItem Header="プロセス優先度">
                <views:ProcessPrioritySettingsTab x:Name="ProcessPriorityTab"/>
            </TabItem>
        </TabControl>

        <!-- ボタン -->
        <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
            <Button Content="閉じる"
                    Width="80"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
