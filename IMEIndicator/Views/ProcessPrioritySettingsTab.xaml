<UserControl x:Class="IMEIndicator.Views.ProcessPrioritySettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IMEIndicator.ViewModels">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ポーリング間隔設定 -->
        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="0,0,0,10">
            <TextBlock Text="監視間隔："
                    VerticalAlignment="Center"/>
            <TextBox x:Name="PollingIntervalInput"
                    Width="60"
                    Margin="5,0,5,0"
                    TextChanged="PollingInterval_TextChanged"/>
            <TextBlock Text="秒（1～1800）"
                    VerticalAlignment="Center"
                    Opacity="0.7"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                x:Name="PriorityRulesGrid"
                Height="200"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Single"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                CellEditEnding="PriorityRulesGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="有効"
                                        Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                        Width="40"/>
                <DataGridTemplateColumn Header="プロセス名" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProcessName}" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBox x:Name="ProcessNameInput"
                                         Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="ProcessNameInput_TextChanged"
                                         PreviewKeyDown="ProcessNameInput_PreviewKeyDown"
                                         LostFocus="ProcessNameInput_LostFocus"/>
                                <Popup x:Name="ProcessNamePopup"
                                       PlacementTarget="{Binding ElementName=ProcessNameInput}"
                                       Placement="Bottom"
                                       StaysOpen="True"
                                       IsOpen="False"
                                       AllowsTransparency="True">
                                    <Border BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Background="White"
                                            MaxHeight="200">
                                        <ListBox x:Name="ProcessNameSuggestions"
                                                 PreviewMouseLeftButtonUp="ProcessNameSuggestion_MouseClick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Style.Triggers>
                                                        <!-- フォーカスがなくても選択状態を視認可能にする -->
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridComboBoxColumn Header="優先度"
                                        SelectedItemBinding="{Binding TargetPriority, UpdateSourceTrigger=PropertyChanged}"
                                        Width="100"/>
                <DataGridCheckBoxColumn Header="E-Core固定"
                                        Binding="{Binding UseECoreOnly, UpdateSourceTrigger=PropertyChanged}"
                                        Width="80">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="IsEnabled" Value="{Binding Source={x:Static viewmodels:ProcessPrioritySettingsViewModel.HasECores}}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static viewmodels:ProcessPrioritySettingsViewModel.HasECores}}" Value="False">
                                    <Setter Property="ToolTip" Value="このCPUにはE-Coreがありません"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="IsEnabled" Value="{Binding Source={x:Static viewmodels:ProcessPrioritySettingsViewModel.HasECores}}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static viewmodels:ProcessPrioritySettingsViewModel.HasECores}}" Value="False">
                                    <Setter Property="ToolTip" Value="このCPUにはE-Coreがありません"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Margin="0,10,0,0">
            <Button Content="追加"
                    Width="60"
                    Margin="0,0,5,0"
                    Click="AddPriorityRule_Click"/>
            <Button Content="削除"
                    Width="60"
                    Click="RemovePriorityRule_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
